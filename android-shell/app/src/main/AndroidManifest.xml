<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Camera + ARCore requirements are merged in from the Unity library (ARCore XR Plugin).
         No INTERNET permission: the app is offline-only (assets served locally). -->
    <uses-feature android:glEsVersion="0x00030000" android:required="true" />

    <application
        android:allowBackup="false"
        android:label="@string/app_name"
        android:icon="@drawable/ic_launcher"
        android:supportsRtl="true"
        tools:replace="android:label,android:icon,android:allowBackup">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden"
            android:screenOrientation="portrait"
            android:theme="@android:style/Theme.Material.NoActionBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Unity AR trainer in its own process so Unity's shutdown never kills the WebView. -->
        <activity
            android:name=".ARUnityActivity"
            android:exported="false"
            android:process=":unity"
            android:screenOrientation="portrait"
            android:launchMode="standard"
            android:hardwareAccelerated="false"
            android:resizeableActivity="false"
            android:theme="@style/UnityThemeSelector"
            android:configChanges="mcc|mnc|locale|touchscreen|keyboard|keyboardHidden|navigation|orientation|screenLayout|uiMode|screenSize|smallestScreenSize|fontScale|layoutDirection|density">
            <meta-data android:name="unityplayer.UnityActivity" android:value="true" />
            <meta-data android:name="android.notch_support" android:value="true" />
        </activity>

        <!-- Drop the Unity library's own launcher activity: ARUnityActivity replaces it. -->
        <activity
            android:name="com.unity3d.player.UnityPlayerActivity"
            tools:node="remove" />
    </application>
</manifest>
